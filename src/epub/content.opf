		<dc:title id="title">A Book-Lover’s Holidays in the Open</dc:title>
		<meta property="file-as" refines="#title">Book-Lover’s Holidays in the Open, A</meta>
		<dc:subject id="subject-1">Hunting</dc:subject>
		<meta property="authority" refines="#subject-1">LCSH</meta>
		<meta property="term" refines="#subject-1">sh85063117</meta>
